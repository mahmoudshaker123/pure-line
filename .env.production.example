DOMAIN=pureline.example
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters

POSTGRES_DB=pureline
POSTGRES_USER=pureline
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

GUNICORN_WORKERS=2
GUNICORN_THREADS=2
DJANGO_LOG_LEVEL=INFO

# Optional: SMTP notifications for new customer requests.
CONTACT_NOTIFICATION_EMAIL=info@pureline.example
DEFAULT_FROM_EMAIL=Pure Line Website <website@pureline.example>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=website@pureline.example
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=1
